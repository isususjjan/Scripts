-- 🔍 Spy الثابت
--------------------------------------------------------------------
local spyResults = {}

local function runSpy()
    spyResults = {}
    local function scan(folder, path, depth)
        if depth > 4 then return end
        local ok = pcall(function()
            for _, obj in pairs(folder:GetChildren()) do
                if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
                    table.insert(spyResults, path .. "/" .. obj.Name .. " [" .. obj.ClassName .. "]")
                end
                scan(obj, path .. "/" .. obj.Name, depth + 1)
            end
        end)
    end
    scan(game.ReplicatedStorage, "RS", 0)
end

local function showSpyResults()
    local ok, err = pcall(function()
        runSpy()
        if not game.CoreGui:FindFirstChild("BrlinGui") then return end
        local old = game.CoreGui.BrlinGui:FindFirstChild("SpyFrame")
        if old then old:Destroy() end

        local SF = Instance.new("Frame")
        SF.Name = "SpyFrame"
        SF.Size = UDim2.new(0, 300, 0, 350)
        SF.Position = UDim2.new(0, 260, 0, 200)
        SF.BackgroundColor3 = Color3.fromRGB(15, 15, 25)
        SF.Active = true
        SF.Draggable = true
        SF.Parent = game.CoreGui.BrlinGui

        local STitle = Instance.new("TextLabel")
        STitle.Size = UDim2.new(1, 0, 0, 30)
        STitle.Text = "🔍 Spy — " .. #spyResults .. " Secrets"
        STitle.TextColor3 = Color3.fromRGB(255, 220, 0)
        STitle.BackgroundTransparency = 1
        STitle.TextSize = 14
        STitle.Parent = SF

        local Scroll = Instance.new("ScrollingFrame")
        Scroll.Size = UDim2.new(1, -10, 1, -40)
        Scroll.Position = UDim2.new(0, 5, 0, 35)
        Scroll.BackgroundColor3 = Color3.fromRGB(10, 10, 18)
        Scroll.ScrollBarThickness = 6
        Scroll.CanvasSize = UDim2.new(0, 0, 0, #spyResults * 22)
        Scroll.Parent = SF

        for i, line in ipairs(spyResults) do
            local lbl = Instance.new("TextLabel")
            lbl.Size = UDim2.new(1, -8, 0, 22)
            lbl.Position = UDim2.new(0, 4, 0, (i - 1) * 22)
            lbl.Text = line
            lbl.TextColor3 = Color3.fromRGB(180, 255, 180)
            lbl.BackgroundTransparency = 1
            lbl.TextSize = 12
            lbl.TextXAlignment = Enum.TextXAlignment.Left
            lbl.Parent = Scroll
        end
    end)
end

--------------------------------------------------------------------
-- 📡 Live Spy — المستمع الحي بنافذة عرض!
--------------------------------------------------------------------
local liveMessages = {}
local liveConnected = false
local liveScroll = nil

local function updateLiveWindow()
    pcall(function()
        if liveScroll and liveScroll.Parent then
            liveScroll:ClearAllChildren()
            local count = #liveMessages
            liveScroll.CanvasSize = UDim2.new(0, 0, 0, count * 26)
            local startI = math.max(1, count - 25)
            local row = 0
            for i = startI, count do
                row = row + 1
                local lbl = Instance.new("TextLabel")
                lbl.Size = UDim2.new(1, -8, 0, 26)
                lbl.Position = UDim2.new(0, 4, 0, (row - 1) * 26)
                lbl.Text = liveMessages[i]
                lbl.TextColor3 = Color3.fromRGB(255, 255, 150)
                lbl.BackgroundTransparency = 1
                lbl.TextSize = 11
                lbl.TextXAlignment = Enum.TextXAlignment.Left
                lbl.TextWrapped = true
                lbl.Parent = liveScroll
            end
        end
    end)
end

local function startLiveSpy()
    local ok, err = pcall(function()
        local remote = game.ReplicatedStorage.Remotes:FindFirstChild("Player")
        if not remote then
            game.StarterGui:SetCore("SendNotification", {
                Title = "❌ Not Found",
                Text = "لم أجد RS/Remotes/Player!",
                Duration = 4
            })
            return
        end

        remote.OnClientEvent:Connect(function(...)
            local args = {...}
            local info = "📥"
            for i, arg in ipairs(args) do
                local t = typeof(arg)
                local v = tostring(arg)
                if #v > 50 then v = v:sub(1, 50) .. "..." end
                info = info .. " [" .. i .. "]" .. t .. ":" .. v
            end
            table.insert(liveMessages, info)
            if #liveMessages > 100 then
                table.remove(liveMessages, 1)
            end
            updateLiveWindow()
        end)

        liveConnected = true
    end)
    if not ok then
        game.StarterGui:SetCore("SendNotification", {
            Title = "Live Spy ❌",
            Text = tostring(err):sub(1, 60),
            Duration = 4
        })
    end
end

local function showLiveWindow()
    local ok, err = pcall(function()
        if not game.CoreGui:FindFirstChild("BrlinGui") then return end
        local old = game.CoreGui.BrlinGui:FindFirstChild("LiveFrame")
        if old then old:Destroy() end

        local LF = Instance.new("Frame")
        LF.Name = "LiveFrame"
        LF.Size = UDim2.new(0, 320, 0, 300)
        LF.Position = UDim2.new(0, 260, 0, 200)
        LF.BackgroundColor3 = Color3.fromRGB(30, 15, 15)
        LF.Active = true
        LF.Draggable = true
        LF.Parent = game.CoreGui.BrlinGui

        local LTitle = Instance.new("TextLabel")
        LTitle.Size = UDim2.new(1, 0, 0, 30)
        LTitle.Text = "📡 Live Spy — " .. #liveMessages .. " msgs"
        LTitle.TextColor3 = Color3.fromRGB(255, 100, 100)
        LTitle.BackgroundTransparency = 1
        LTitle.TextSize = 14
        LTitle.Parent = LF

        liveScroll = Instance.new("ScrollingFrame")
        liveScroll.Size = UDim2.new(1, -10, 1, -40)
        liveScroll.Position = UDim2.new(0, 5, 0, 35)
        liveScroll.BackgroundColor3 = Color3.fromRGB(15, 8, 8)
        liveScroll.ScrollBarThickness = 6
        liveScroll.Parent = LF

        updateLiveWindow()
    end)
end


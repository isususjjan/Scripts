local player = game.Players.LocalPlayer

local function notify(title, text)
    pcall(function()
        game.StarterGui:SetCore("SendNotification", {
            Title = title, Text = text, Duration = 3
        })
    end)
end

--------------------------------------------------------------------
-- ⚡ محرك السرعة الشامل
--------------------------------------------------------------------
local speedOn = false
local speedConn = nil
local SPEED_VALUE = 300  -- القصوى العملية (أعلى منها = تطرش من الخريطة!)

local function maxEverything(char)
    pcall(function()
        -- ١. سرعة المشي العادية
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.WalkSpeed = SPEED_VALUE
            hum.JumpPower = 120
        end

        -- ٢. سرعة الحمل (BodyVelocity المربوط بجسدك أثناء حمل الحيوان!)
        for _, v in pairs(char:GetDescendants()) do
            if v:IsA("BodyVelocity") then
                v.MaxForce = Vector3.new(1e9, 1e9, 1e9)
                v.Velocity = v.Velocity.Unit * SPEED_VALUE
            elseif v:IsA("AlignPosition") then
                v.MaxForce = 1e9
            end
        end
    end)
end

local function setSpeed(on)
    if speedConn then
        speedConn:Disconnect()
        speedConn = nil
    end

    if on then
        -- تطبيق فوري
        pcall(function()
            if player.Character then maxEverything(player.Character) end
        end)

        -- 🔥 الحراسة المستمرة:
        -- أي شيء جديد في شخصيتك → نسرعوه!
        -- أي تغيير سرعة من اللعبة → نعيدها القصوى!
        speedConn = RunService or game:GetService("RunService")
        speedConn = speedConn.Heartbeat:Connect(function()
            pcall(function()
                local char = player.Character
                if char then maxEverything(char) end
            end)
        end)

        -- ومراقبة الشخصية الجديدة عند Respawn
        player.CharacterAdded:Connect(function(char)
            if speedOn then
                task.wait(0.5)
                maxEverything(char)
                char:WaitForChild("Humanoid")
                char.Humanoid.WalkSpeed = SPEED_VALUE
            end
        end)
    else
        -- إيقاف: نرجع السرعة الطبيعية
        pcall(function()
            local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
            if hum then
                hum.WalkSpeed = 16
                hum.JumpPower = 50
            end
        end)
    end
end


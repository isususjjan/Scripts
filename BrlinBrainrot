-- 🕳️ Down Earth — المتغيرات
--------------------------------------------------------------------
local earthOn = false
local earthConn = nil
local cycleThread = nil
local undergroundFloor = nil
local savedEarthY = nil
local undergroundY = nil

local function setCharCollision(char, on)
    pcall(function()
        for _, part in pairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = on
            end
        end
    end)
end

-- 🛗 صعود للسطح
local function riseToSurface()
    if earthConn then
        earthConn:Disconnect()
        earthConn = nil
    end
    if undergroundFloor then
        undergroundFloor:Destroy()
        undergroundFloor = nil
    end
    pcall(function()
        local root = getRoot()
        local upY = savedEarthY or (root.Position.Y - UNDERGROUND_OFFSET)
        root.Anchored = true
        root.CFrame = CFrame.new(root.Position.X, upY, root.Position.Z)
        task.wait(0.15)
        root.Anchored = false
        setCharCollision(player.Character, true)
        local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
        if hum then hum:ChangeState(Enum.HumanoidStateType.GettingUp) end
    end)
end

-- 🕳️ الغوص
local function diveUnderground()
    pcall(function()
        local root = getRoot()
        undergroundY = (savedEarthY or root.Position.Y) + UNDERGROUND_OFFSET

        if not undergroundFloor then
            undergroundFloor = Instance.new("Part")
            undergroundFloor.Name = "BrlinGhostFloor"
            undergroundFloor.Size = Vector3.new(15, 1, 15)
            undergroundFloor.Transparency = 1
            undergroundFloor.Anchored = true
            undergroundFloor.CanCollide = true
            undergroundFloor.Parent = workspace
        end
        undergroundFloor.CFrame = CFrame.new(root.Position.X, undergroundY - 3.5, root.Position.Z)

        setCharCollision(player.Character, false)

        root.Anchored = true
        root.CFrame = CFrame.new(root.Position.X, undergroundY, root.Position.Z)
        task.wait(0.15)
        root.Anchored = false

        if earthConn then earthConn:Disconnect() end
        earthConn = RunService.Stepped:Connect(function()
            pcall(function()
                local c = player.Character
                if not c then return end
                local r = c:FindFirstChild("HumanoidRootPart")
                if not r then return end

                for _, part in pairs(c:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                    end
                end

                if undergroundFloor and undergroundFloor.Parent then
                    undergroundFloor.CFrame = CFrame.new(
                        r.Position.X,
                        undergroundY - 3.5,
                        r.Position.Z
                    )
                end

                local pos = r.Position
                if math.abs(pos.Y - undergroundY) > 3 then
                    r.CFrame = CFrame.new(pos.X, undergroundY, pos.Z)
                end
            end)
        end)
    end)
end

-- ⏹️ الإيقاف (بدون Respawn تلقائي — أنت تسويه بيدك!)
local function stopDownEarth()
    earthOn = false

    if cycleThread then
        task.cancel(cycleThread)
        cycleThread = nil
    end

    riseToSurface()

    notify("⬆️ Stopped!", "خرجت من الغوص ✅", 4)
end

-- ▶️ الدورة الوقائية!
local function startDownEarth()
    pcall(function()
        savedEarthY = getRoot().Position.Y
    end)

    cycleThread = task.spawn(function()
        while earthOn do
            -- ١. الغوص
            diveUnderground()

            -- ٢. 15 ثانية تحت
            local elapsed = 0
            while elapsed < SAFE_TIME and earthOn do
                task.wait(1)
                elapsed = elapsed + 1
                if elapsed % 5 == 0 and earthOn then
                    notify("⏳ " .. (SAFE_TIME - elapsed) .. "s", "قبل التحديث التلقائي...", 1)
                end
            end
            if not earthOn then break end

            -- ٣. خروج لحظي!
            riseToSurface()

            -- ٤. استراحة
            notify("⬆️ Refresh!", "استراحة — عودة وشيكة...", 2)
            local breakT = 0
            while breakT < SURFACE_BREAK and earthOn do
                task.wait(0.5)
                breakT = breakT + 0.5
            end
            if not earthOn then break end
        end

        if not earthOn then
            riseToSurface()
        end
    end)
end


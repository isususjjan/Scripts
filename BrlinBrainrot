--------------------------------------------------------------------
-- 🕳️ Down Earth PRO — قفل Y + سرعة الصاروخ!
--------------------------------------------------------------------
local earthOn = false
local earthConn = nil
local savedEarthY = nil
local undergroundY = nil
local UNDERGROUND_OFFSET = -20  -- العمق تحت الأرض

local function startDownEarth()
    local root = getRoot()
    
    -- نحفظ ارتفاعك الأصلي ونحدد عمق النزول
    savedEarthY = root.Position.Y
    undergroundY = root.Position.Y + UNDERGROUND_OFFSET
    
    -- ⬇️ النزول الأولي
    root.Anchored = true
    root.CFrame = CFrame.new(root.Position.X, undergroundY, root.Position.Z)
    task.wait(0.1)
    root.Anchored = false

    -- نرفع سرعة المشي للقصوى!
    pcall(function()
        local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
        if hum then hum.WalkSpeed = UNDERGROUND_SPEED end
    end)

    -- ⚡ القفل المستمر + الدفع بالسرعة!
    earthConn = RunService.Stepped:Connect(function()
        pcall(function()
            local char = player.Character
            if not char then return end
            local r = char:FindFirstChild("HumanoidRootPart")
            if not r then return end

            -- ١. قفل Y: إذا السيرفر رفعك — نرجعك فوراً!
            local pos = r.Position
            if math.abs(pos.Y - undergroundY) > 3 then
                r.CFrame = CFrame.new(pos.X, undergroundY, pos.Z)
            end

            -- ٢. إلغاء التصادم (تعبر كل شيء!)
            for _, part in pairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end

            -- ٣. 🔥 الدفع بالسرعة — باتجاه حركتك!
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then
                hum.WalkSpeed = UNDERGROUND_SPEED  -- نحافظ على السرعة باستمرار!
                local moveDir = hum.MoveDirection
                if moveDir.Magnitude > 0 then
                    -- تتحرك → ندفعك بهذا الاتجاه بأقصى سرعة!
                    r.AssemblyLinearVelocity = Vector3.new(
                        moveDir.X * UNDERGROUND_SPEED, 
                        0, 
                        moveDir.Z * UNDERGROUND_SPEED
                    )
                else
                    -- واقف؟ نثبت مكانك
                    r.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                end
            end
        end)
    end)
end

local function stopDownEarth()
    -- إيقاف القفل
    if earthConn then
        earthConn:Disconnect()
        earthConn = nil
    end
    
    -- ⬆️ الرفع: نفس X/Z بالضبط — فقط Y يعود للفوق!
    pcall(function()
        local root = getRoot()
        local upY = savedEarthY or (root.Position.Y - UNDERGROUND_OFFSET)
        root.Anchored = true
        root.CFrame = CFrame.new(root.Position.X, upY, root.Position.Z)
        task.wait(0.1)
        root.Anchored = false
        
        -- نرجع السرعة الطبيعية
        local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.WalkSpeed = 16
            hum:ChangeState(Enum.HumanoidStateType.GettingUp)
        end
    end)
end


makeButton("Tp 🎩", 2, function()
    if SavedCFrame == nil then
        StatusText.Text = "❌ No Save"
        return
    end
    local root = getRoot()
    root.Anchored = true
    task.wait()
    root.CFrame = SavedCFrame + Vector3.new(0, 3, 0)
    task.wait(0.1)
    root.Anchored = false
    pcall(function()
        local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
        if hum then hum:ChangeState(Enum.HumanoidStateType.GettingUp) end
    end)
    notify("Teleport Successful ⚡", "", 3)
end)


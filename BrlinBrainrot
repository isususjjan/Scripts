-- 🕳️ Down Earth — Collision Off أولاً → نزول مباشر → أرضية شبحية!
--------------------------------------------------------------------
local earthOn = false
local earthConn = nil
local undergroundFloor = nil
local savedEarthY = nil
local undergroundY = nil

-- إطفاء/تشغيل التصادم
local function setCharCollision(char, on)
    pcall(function()
        for _, part in pairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = on
            end
        end
    end)
end

local function startDownEarth()
    local root = getRoot()
    local char = player.Character
    
    savedEarthY = root.Position.Y
    undergroundY = root.Position.Y + UNDERGROUND_OFFSET
    
    -- ١. ⭐ نطفئ التصادم أولاً — حتى لا تقاومنا الأرض أثناء النزول!
    if char then
        setCharCollision(char, false)
    end

    -- ٢. النزول المباشر (مثل v1.3 المجربة والناجحة!)
    root.Anchored = true
    root.CFrame = CFrame.new(root.Position.X, undergroundY, root.Position.Z)
    task.wait(0.15)
    root.Anchored = false

    -- ٣. الأرضية الشبحية تحت قدميك!
    if not undergroundFloor then
        undergroundFloor = Instance.new("Part")
        undergroundFloor.Name = "BrlinGhostFloor"
        undergroundFloor.Size = Vector3.new(15, 1, 15)
        undergroundFloor.Transparency = 1
        undergroundFloor.Anchored = true
        undergroundFloor.CanCollide = true
        undergroundFloor.Parent = workspace
    end

    -- ٤. حلقة المتابعة الدائمة
    earthConn = RunService.Stepped:Connect(function()
        pcall(function()
            local c = player.Character
            if not c then return end
            local r = c:FindFirstChild("HumanoidRootPart")
            if not r then return end
            
            -- التصادم يبقى مطفأً (تعبر كل شيء!)
            for _, part in pairs(c:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end
            
            -- الأرضية الشبحية تلاحق قدميك!
            if undergroundFloor and undergroundFloor.Parent then
                undergroundFloor.CFrame = CFrame.new(
                    r.Position.X, 
                    undergroundY - 3.5,
                    r.Position.Z
                )
            end

            -- شبكة أمان: لو سقطت تحت الأرضية → نرجعك فوقها!
            if r.Position.Y < undergroundY - 4 then
                r.CFrame = CFrame.new(r.Position.X, undergroundY, r.Position.Z)
            end

            -- 🛡️ شبكة أمان الحياة
            pcall(function()
                local hum = c:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health < (hum.MaxHealth - 1) then
                    stopDownEarth()
                end
            end)
        end)
    end)
    
    -- 💡 لا نلمس WalkSpeed إطلاقاً — سرعتك الحقيقية تعمل على الأرضية الشبحية!
end

local function stopDownEarth()
    if earthConn then
        earthConn:Disconnect()
        earthConn = nil
    end
    
    -- 🗑️ حذف الأرضية الشبحية
    if undergroundFloor then
        undergroundFloor:Destroy()
        undergroundFloor = nil
    end
    
    -- ⬆️ الرفع المباشر: نفس X/Z بالضبط — فقط Y يعود للفوق!
    pcall(function()
        local root = getRoot()
        local upY = savedEarthY or (root.Position.Y - UNDERGROUND_OFFSET)
        root.Anchored = true
        root.CFrame = CFrame.new(root.Position.X, upY, root.Position.Z)
        task.wait(0.15)
        root.Anchored = false
        
        -- ♻️ إعادة تشغيل التصادم — رجعت لاعب عادي فوق الأرض!
        local char = player.Character
        if char then
            setCharCollision(char, true)
        end
        
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if hum then hum:ChangeState(Enum.HumanoidStateType.GettingUp) end
    end)

    notify("⬆️ Back Up!", "نفس المكان فوق الأرض ✅", 4)
end


    saveCFrame(root.CFrame)
    updateStatus()
    game.StarterGui:SetCore("SendNotification", {
        Title = "📍 Saved!",
        Text = "قاعدتك محفوظة — اذهب واسرق! ⚡",
        Duration = 3
    })
end)

makeButton("🗑️  Remove Tp", 94, function()
    clearCFrame()
    updateStatus()
    game.StarterGui:SetCore("SendNotification", {
        Title = "🗑️ Cleared!",
        Text = "All saves removed ❌",
        Duration = 3
    })
end)


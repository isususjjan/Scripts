local autoLockOn = false
local lockThread = nil

--------------------------------------------------------------------
-- 🔒 حلقة الأوتولوك — رصد الضوء!
--------------------------------------------------------------------
local function autoLockLoop()
    task.spawn(function()
        game.StarterGui:SetCore("SendNotification", {
            Title = "🔒 Auto Lock",
            Text = "جاري البحث عن الضوء الأخضر...",
            Duration = 4
        })

        local padInfo = findGreenPad()

        if not padInfo then
            game.StarterGui:SetCore("SendNotification", {
                Title = "❌ Auto Lock",
                Text = "لم أجد الضوء الأخضر! قف داخل قاعدتك وأعد المحاولة",
                Duration = 5
            })
            autoLockOn = false
            return
        end

        local pad = padInfo.pad
        game.StarterGui:SetCore("SendNotification", {
            Title = "✅ Found Green Pad!",
            Text = padInfo.name .. (padInfo.dist and (" 📏" .. padInfo.dist .. "m") or ""),
            Duration = 4
        })

        -- ١. أول دخول على الضوء فوراً (TP خفيف!)
        pcall(function()
            local root = getRoot()
            root.Anchored = true
            root.CFrame = pad.CFrame + Vector3.new(0, 3, 0)
            task.wait(0.3)
            root.Anchored = false
        end)
        
        -- ننتظر 3 ثواني للتأكد أن القفل اشتغل
        task.wait(3)

        -- ٢. الحلقة: نراقب الضوء — إذا انطفأ/اختفى = انتهى القفل → نعود ندوس!
        local lastTouch = os.clock()
        while autoLockOn do
            task.wait(1)

            local stillExists = false
            local stillGreen = false
            pcall(function()
                if pad and pad.Parent then
                    stillExists = true
                    -- هل ما زال أخضر؟
                    if pad.Color.G > 0.5 and pad.Color.R < 0.6 then
                        stillGreen = true
                    end
                end
            end)

            -- الضوء اختفى أو فقد لونه = انتهى القفل! نعود ندوس!
            if (not stillExists) or (not stillGreen) then
                game.StarterGui:SetCore("SendNotification", {
                    Title = "🔒 Re-Locking!",
                    Text = "انتهى القفل — نعيد الدوس فوراً! ⚡",
                    Duration = 2
                })
                
                pcall(function()
                    local root = getRoot()
                    root.Anchored = true
                    root.CFrame = CFrame.new(pad and pad.Position or lastTouch and Vector3.new() or Vector3.new()) + Vector3.new(0, 3, 0)
                    task.wait(0.3)
                    root.Anchored = false
                end)
                lastTouch = os.clock()
                task.wait(3) -- ننتظر إعادة تفعيل القفل
            end
        end
    end)
end


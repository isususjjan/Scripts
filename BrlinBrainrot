local player = game.Players.LocalPlayer

local function getRoot()
    local char = player.Character or player.CharacterAdded:Wait()
    return char:WaitForChild("HumanoidRootPart")
end

--------------------------------------------------------------------
-- 🔍 البحث عن لوح الضوء الأخضر في قاعدتك!
--------------------------------------------------------------------
local function findGreenPad()
    local result = nil
    pcall(function()
        local myName = string.lower(player.Name)
        local displayName = string.lower(player.DisplayName or "")
        
        -- الطريقة ١: نجد قاعدتك عبر لافتة اسمك، وندور في جوّاها على الضوء الأخضر
        local candidates = {}
        for _, obj in pairs(workspace:GetDescendants()) do
            if (obj:IsA("TextLabel") or obj:IsA("BillboardGui")) and obj:IsA("GuiBase") == false then
                -- TextLabel في workspace (لافيه GUI)
                if obj:IsA("TextLabel") then
                    local txt = ""
                    pcall(function() txt = string.lower(obj.Text or "") end)
                    if (myName ~= "" and txt:find(myName, 1, true))
                        or (displayName ~= "" and txt:find(displayName, 1, true)) then
                        local base = obj
                        for _ = 1, 5 do
                            if base.Parent and base.Parent ~= workspace then
                                base = base.Parent
                            else
                                break
                            end
                        end
                        table.insert(candidates, base)
                    end
                end
            end
        end

        -- في كل قاعدة مرشحة: ندور على Part أخضر نيون
        for _, base in pairs(candidates) do
            pcall(function()
                for _, part in pairs(base:GetDescendants()) do
                    if part:IsA("BasePart") then
                        local isGreen = false
                        pcall(function()
                            -- الضوء الأخضر: لون أخضر ساطع
                            if part.Color.G > 0.6 and part.Color.R < 0.5 and part.Color.B < 0.5 then
                                isGreen = true
                            end
                        end)
                        if isGreen then
                            result = {
                                pad = part,
                                name = part.Name
                            }
                            break
                        end
                    end
                end
            end)
            if result then break end
        end

        -- الطريقة ٢ (احتياط): أقرب Part أخضر نيون ليك في العالم كله!
        if result == nil then
            local myPos = getRoot().Position
            local bestDist = 200 -- حد البحث 200 متر
            pcall(function()
                for _, part in pairs(workspace:GetDescendants()) do
                    if part:IsA("BasePart") then
                        local isGreen = false
                        pcall(function()
                            if part.Color.G > 0.6 and part.Color.R < 0.5 and part.Color.B < 0.5
                                and part.Transparency < 0.7 and part.Size.Magnitude < 30 then
                                isGreen = true
                            end
                        end)
                        if isGreen then
                            local dist = (part.Position - myPos).Magnitude
                            if dist < bestDist then
                                bestDist = dist
                                result = {
                                    pad = part,
                                    name = part.Name,
                                    dist = math.floor(dist)
                                }
                            end
                        end
                    end
                end
            end)
        end
    end)
    return result
end


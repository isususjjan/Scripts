                Title = "❌ No Save!",
                Text = "اضغط Set داخل القاعدة أولاً!",
                Duration = 3
            })
            return
        end
        stayOn = true
        toggleStay(true)
    else
        stayOn = false
        toggleStay(false)
    end
end)


local btn = Instance.new("TextButton")
btn.Size = UDim2.new(1, -16, 0, 40)
btn.Position = UDim2.new(0, 8, 0, 45)
btn.Text = "⚡ MAX SPEED [OFF]"
btn.TextColor3 = Color3.fromRGB(255, 255, 255)
btn.BackgroundColor3 = Color3.fromRGB(45, 45, 60)
btn.TextSize = 14
btn.Parent = Frame

btn.MouseButton1Click:Connect(function()
    speedOn = not speedOn
    if speedOn then
        btn.BackgroundColor3 = Color3.fromRGB(0, 150, 70)
        btn.Text = "⚡ MAX SPEED [ON]"
        setSpeed(true)
        notify("⚡ MAX SPEED ON!", "سرعتك + سرعة حملك = القصوى! ✈️")
    else
        btn.BackgroundColor3 = Color3.fromRGB(45, 45, 60)
        btn.Text = "⚡ MAX SPEED [OFF]"
        setSpeed(false)
        notify("⚡ Speed OFF", "رجعت الطبيعية", 3)
    end
end)


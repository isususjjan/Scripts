-- ١. زر Set — حفظ المكان الحالي
makeButton("📍  Set", 55, function()
    local root = getRoot()
    saveCFrame(root.CFrame)
    updateStatus()
    game.StarterGui:SetCore("SendNotification", {
        Title = "📍 Saved!",
        Text = "Position saved permanently ✅",
        Duration = 3
    })
end)

-- ٢. زر Tp — الانتقال للمكان المحفوظ
makeButton("🚀  Tp", 98, function()
    if SavedCFrame == nil then
        game.StarterGui:SetCore("SendNotification", {
            Title = "❌ No Save!",
            Text = "اضغط Set أولاً لحفظ مكان",
            Duration = 3
        })
        return
    end
    local root = getRoot()
    root.Anchored = true
    task.wait()
    root.CFrame = SavedCFrame + Vector3.new(0, 3, 0)
    task.wait(0.1)
    root.Anchored = false
    pcall(function()
        local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
        if hum then hum:ChangeState(Enum.HumanoidStateType.GettingUp) end
    end)
    game.StarterGui:SetCore("SendNotification", {
        Title = "🚀 Teleported!",
        Text = "Back to your saved spot ✅",
        Duration = 3
    })
end)

-- ٣. زر Remove Teleport — مسح كل شيء
makeButton("🗑️  Remove Teleport", 141, function()
    toggleStay(false) -- إطفاء Stay أيضاً إن كان شغال!
    clearCFrame()
    updateStatus()
    game.StarterGui:SetCore("SendNotification", {
        Title = "🗑️ Cleared!",
        Text = "All saves removed ❌",
        Duration = 3
    })
end)

-- ٤. زر Stay Inside — مضاد الطرد!
makeButton("🛡️ Stay Inside [OFF]", 184, function(on)
    if on and SavedCFrame == nil then
        game.StarterGui:SetCore("SendNotification", {
            Title = "❌ No Save!",
            Text = "اضغط Set داخل القاعدة أولاً!",
            Duration = 3
        })
        return false -- يرفض التفعيل بدون نقطة محفوظة!
    end
    toggleStay(on)
end)


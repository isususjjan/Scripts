makeButton("🚀  Tp", 94, function()
    if SavedCFrame == nil then
        game.StarterGui:SetCore("SendNotification", {
            Title = "❌ No Save!",
            Text = "اضغط Set أولاً",
            Duration = 3
        })
        return
    end
    local root = getRoot()
    root.Anchored = true
    task.wait()
    root.CFrame = SavedCFrame + Vector3.new(0, 3, 0)
    task.wait(0.1)
    root.Anchored = false
    pcall(function()
        local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
        if hum then hum:ChangeState(Enum.HumanoidStateType.GettingUp) end
    end)
    game.StarterGui:SetCore("SendNotification", {
        Title = "🚀 Teleported!",
        Text = "Back to saved spot ✅",
        Duration = 3
    })
end)

makeButton("🗑️  Remove Teleport", 133, function()

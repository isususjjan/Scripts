-- زر تفاعلي متطور (يدعم ON/OFF بالنص!)
local function makeToggleButton(text, yPos, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -16, 0, 34)
    btn.Position = UDim2.new(0, 8, 0, yPos)
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.BackgroundColor3 = Color3.fromRGB(45, 45, 60)
    btn.TextSize = 13
    btn.Parent = Frame

    local on = false
    btn.MouseButton1Click:Connect(function()
        on = not on
        if on then
            btn.BackgroundColor3 = Color3.fromRGB(0, 150, 70)
            btn.Text = string.gsub(text, "%[OFF%]", "[ON]")
        else
            btn.BackgroundColor3 = Color3.fromRGB(45, 45, 60)
            btn.Text = string.gsub(text, "%[ON%]", "[OFF]")
        end
        callback(on)
    end)
end

local function makeButton(text, yPos, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -16, 0, 34)
    btn.Position = UDim2.new(0, 8, 0, yPos)
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.BackgroundColor3 = Color3.fromRGB(45, 45, 60)
    btn.TextSize = 13
    btn.Parent = Frame
    btn.MouseButton1Click:Connect(callback)
end


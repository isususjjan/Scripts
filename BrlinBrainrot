-- 🎯 Prompt Steal — الزر القسري!
--------------------------------------------------------------------
local function findStealPrompts()
    local list = {}
    pcall(function()
        local myPos = getRoot().Position
        for _, prompt in pairs(workspace:GetDescendants()) do
            if prompt:IsA("ProximityPrompt") then
                local parent = prompt.Parent
                local model = parent and (parent:IsA("Model") and parent or parent.Parent)
                if model then
                    local pp = model:FindFirstChild("HumanoidRootPart")
                        or model:FindFirstChildWhichIsA("BasePart")
                    if pp then
                        local dist = math.floor((pp.Position - myPos).Magnitude)
                        table.insert(list, {
                            prompt = prompt,
                            name = model.Name,
                            dist = dist,
                            enabled = prompt.Enabled
                        })
                    end
                end
            end
        end
        table.sort(list, function(a, b) return a.dist < b.dist end)
    end)
    return list
end

local function forceTrigger(prompt)
    local ok, err = pcall(function()
        prompt:InputHoldBegin()
        local hold = 0.3
        pcall(function()
            if prompt.HoldDuration and prompt.HoldDuration > hold then
                hold = prompt.HoldDuration
            end
        end)
        task.wait(hold + 0.15)
        prompt:InputHoldEnd()
    end)
    return ok, err
end

--------------------------------------------------------------------
-- 📡 Lock Radar — رادار الأقفال!
--------------------------------------------------------------------
local radarConn = nil
local lockStates = {} -- [baseModel] = true/false (locked)

local function isLaserPart(part)
    local n = string.lower(part.Name)
    if n:find("laser") or n:find("lock") or n:find("lazer") then
        return true
    end
    -- جدران الليزر الحمراء: Neon أحمر شفاف
    pcall(function()
        if part.Material == Enum.Material.Neon
            and part.Color.R > 0.7 and part.Color.G < 0.3 and part.Color.B < 0.3
            and part.Transparency < 0.6 then
            return true
        end
    end)
    return false
end

local function scanBaseLocks()
    local result = {}
    pcall(function()
        local myPos = getRoot().Position
        local checked = {}
        for _, part in pairs(workspace:GetDescendants()) do
            if part:IsA("BasePart") and isLaserPart(part) and not checked[part] then
                -- ابحث عن القاعدة الأب التي تحتويه
                local base = part
                for _ = 1, 4 do
                    if base.Parent and base.Parent ~= workspace then
                        base = base.Parent
                    else
                        break
                    end
                end
                if base and base ~= workspace and not checked[base] then
                    checked[base] = true
                    local center = base:GetModelCFrame().Position
                    local dist = math.floor((center - myPos).Magnitude)
                    table.insert(result, {
                        base = base,
                        name = base.Name,
                        dist = dist,
                        locked = true
                    })
                end
            end
        end
        table.sort(result, function(a, b) return a.dist < b.dist end)
    end)
    return result
end


local function argsToString(args)
    local info = ""
    for i, arg in ipairs(args) do
        local t = typeof(arg)
        local v = tostring(arg)
        if #v > 200 then v = v:sub(1, 200) .. "..." end
        info = info .. " [" .. i .. "]" .. t .. ":" .. v
    end
    if info == "" then info = " (empty)" end
    return info
end

local function addLog(msg)
    table.insert(liveMessages, msg)
    if #liveMessages > 150 then
        table.remove(liveMessages, 1)
    end
    pcall(function()
        if liveScroll and liveScroll.Parent then
            liveScroll:ClearAllChildren()
            local count = #liveMessages
            liveScroll.CanvasSize = UDim2.new(0, 0, 0, count * 44)
            local startI = math.max(1, count - 20)
            local row = 0
            for i = startI, count do
                row = row + 1
                local isOut = string.find(liveMessages[i], "📤", 1, true) ~= nil
                local lbl = Instance.new("TextLabel")
                lbl.Size = UDim2.new(1, -8, 0, 42)
                lbl.Position = UDim2.new(0, 4, 0, (row - 1) * 44)
                lbl.Text = liveMessages[i]
                lbl.TextColor3 = isOut and Color3.fromRGB(100, 220, 255) or Color3.fromRGB(255, 255, 150)
                lbl.BackgroundTransparency = 1
                lbl.TextSize = 11
                lbl.TextXAlignment = Enum.TextXAlignment.Left
                lbl.TextWrapped = true
                lbl.Parent = liveScroll
            end
            if liveTitle then
                liveTitle.Text = "📡 Live Spy — " .. count .. " msgs"
            end
        end
    end)
end

local function hookOutgoing()
    local ok = pcall(function()
        local oldNamecall
        oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
            local method = getnamecallmethod()
            if (method == "FireServer" and self:IsA("RemoteEvent"))
                or (method == "InvokeServer" and self:IsA("RemoteFunction")) then
                local args = {...}
                local parentName = self.Parent and self.Parent.Name or "?"
                addLog("📤 OUT @[" .. parentName .. "/" .. self.Name .. "]" .. argsToString(args))
            end
            return oldNamecall(self, ...)
        end)
    end)
    return ok
end

local function hookIncoming()
    local ok = pcall(function()
        local function listen(folder, path, depth)
            if depth > 4 then return end
            for _, obj in pairs(folder:GetChildren()) do
                if obj:IsA("RemoteEvent") or obj:IsA("UnreliableRemoteEvent") then
                    local rPath = path .. "/" .. obj.Name
                    obj.OnClientEvent:Connect(function(...)
                        addLog("📥 IN " .. rPath .. argsToString({...}))
                    end)
                end
                listen(obj, path .. "/" .. obj.Name, depth + 1)
            end
        end
        listen(game.ReplicatedStorage, "RS", 0)
        listen(workspace, "WS", 0)
    end)
    return ok
end


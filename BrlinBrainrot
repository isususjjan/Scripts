local liveMessages = {}
local liveScroll = nil
local liveTitle = nil

local function argsToString(args)
    local info = ""
    for i, arg in ipairs(args) do
        local t = typeof(arg)
        local v = tostring(arg)
        if #v > 200 then v = v:sub(1, 200) .. "..." end
        info = info .. " [" .. i .. "]" .. t .. ":" .. v
    end
    if info == "" then info = " (empty)" end
    return info
end

local function addLog(msg)
    table.insert(liveMessages, msg)
    if #liveMessages > 150 then
        table.remove(liveMessages, 1)
    end
    pcall(function()
        if liveScroll and liveScroll.Parent then
            liveScroll:ClearAllChildren()
            local count = #liveMessages
            liveScroll.CanvasSize = UDim2.new(0, 0, 0, count * 44)
            local startI = math.max(1, count - 20)
            local row = 0
            for i = startI, count do
                row = row + 1
                local isOut = string.find(liveMessages[i], "📤", 1, true) ~= nil
                local isGrab = string.find(liveMessages[i], "✊", 1, true) ~= nil
                local color = Color3.fromRGB(255, 255, 150)
                if isOut then color = Color3.fromRGB(100, 220, 255)
                elseif isGrab then color = Color3.fromRGB(150, 255, 150) end
                local lbl = Instance.new("TextLabel")
                lbl.Size = UDim2.new(1, -8, 0, 42)
                lbl.Position = UDim2.new(0, 4, 0, (row - 1) * 44)
                lbl.Text = liveMessages[i]
                lbl.TextColor3 = color
                lbl.BackgroundTransparency = 1
                lbl.TextSize = 11
                lbl.TextXAlignment = Enum.TextXAlignment.Left
                lbl.TextWrapped = true
                lbl.Parent = liveScroll
            end
            if liveTitle then
                liveTitle.Text = "📡 Spy — " .. count .. " msgs"
            end
        end
    end)
end

--------------------------------------------------------------------
-- ١) هوك الصادر — Namecall + Index (الناجح!)
--------------------------------------------------------------------
local function hookOutgoing()
    pcall(function()
        local oldNamecall
        oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
            local method = getnamecallmethod()
            if (method == "FireServer" and self:IsA("RemoteEvent"))
                or (method == "InvokeServer" and self:IsA("RemoteFunction")) then
                local args = {...}
                local parentName = self.Parent and self.Parent.Name or "?"
                addLog("📤 OUT @[" .. parentName .. "/" .. self.Name .. "]" .. argsToString(args))
            end
            return oldNamecall(self, ...)
        end)

        local oldIndex
        oldIndex = hookmetamethod(game, "__index", function(self, key)
            local val = oldIndex(self, key)
            if key == "FireServer" and typeof(val) == "function"
                and pcall(function() return self:IsA("RemoteEvent") end)
                and self:IsA("RemoteEvent") then
                return function(...)
                    local args = {...}
                    local parentName = self.Parent and self.Parent.Name or "?"
                    addLog("📤 OUT(idx) @[" .. parentName .. "/" .. self.Name .. "]" .. argsToString(args))
                    return val(table.unpack(args))
                end
            elseif key == "InvokeServer" and typeof(val) == "function"
                and pcall(function() return self:IsA("RemoteFunction") end)
                and self:IsA("RemoteFunction") then
                return function(...)
                    local args = {...}
                    local parentName = self.Parent and self.Parent.Name or "?"
                    addLog("📤 OUT(idx) @[" .. parentName .. "/" .. self.Name .. "]" .. argsToString(args))
                    return val(table.unpack(args))
                end
            end
            return val
        end)
        addLog("✅ OUT hooks ON (namecall + index)")
    end)
end

--------------------------------------------------------------------
-- ٢) هوك الوارد — كل الريموتات
--------------------------------------------------------------------
local function hookIncoming()
    pcall(function()
        local function listen(folder, path, depth)
            if depth > 4 then return end
            for _, obj in pairs(folder:GetChildren()) do
                if obj:IsA("RemoteEvent") or obj:IsA("UnreliableRemoteEvent") then
                    local rPath = path .. "/" .. obj.Name
                    obj.OnClientEvent:Connect(function(...)
                        addLog("📥 IN " .. rPath .. argsToString({...}))
                    end)
                end
                listen(obj, path .. "/" .. obj.Name, depth + 1)
            end
        end
        listen(game.ReplicatedStorage, "RS", 0)
        listen(workspace, "WS", 0)
        addLog("✅ IN hooks ON")
    end)
end

--------------------------------------------------------------------
-- ٣) مراقبة أزرار السرقة (ProximityPrompt)!
--------------------------------------------------------------------
local function hookPrompts()
    pcall(function()
        local function listenPrompts(folder, depth)
            if depth > 5 then return end
            for _, obj in pairs(folder:GetChildren()) do
                if obj:IsA("ProximityPrompt") then
                    obj.Triggered:Connect(function(who)
                        if who == player then
                            addLog("✊ PROMPT TRIGGERED: " .. obj.Name .. " @" .. (obj.Parent and obj.Parent.Name or "?"))
                        end
                    end)
                    obj.PromptButtonHoldEnded:Connect(function(who)
                        if who == player then
                            addLog("✊ PROMPT hold END: " .. obj.Name)
                        end
                    end)
                end
                listenPrompts(obj, depth + 1)
            end
        end
        listenPrompts(workspace, 0)
        addLog("✅ PROMPT hooks ON")
    end)
end

--------------------------------------------------------------------
-- ٤) مراقبة ما يدخل شخصيتك (الالتقاط!)
--------------------------------------------------------------------
local function hookCarry()
    pcall(function()
        local function watch(char)
            char.ChildAdded:Connect(function(child)
                addLog("✊ CHAR +" .. child.ClassName .. ":" .. child.Name)
            end)
            char.ChildRemoved:Connect(function(child)
                addLog("✊ CHAR -" .. child.ClassName .. ":" .. child.Name)
            end)
        end
        if player.Character then watch(player.Character) end
        player.CharacterAdded:Connect(watch)
        addLog("✅ CHAR monitor ON")
    end)
end

--------------------------------------------------------------------
-- ٥) مراقبة الحيوانات الجديدة كلها (رسائل الأحداث)
--------------------------------------------------------------------
local function hookWorld()
    pcall(function()
        workspace.DescendantAdded:Connect(function(obj)
            if obj:IsA("ProximityPrompt") then
                addLog("✊ NEW PROMPT @[" .. (obj.Parent and obj.Parent.Name or "?") .. "]")
            end
        end)
        addLog("✅ WORLD monitor ON")
    end)
end


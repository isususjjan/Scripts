--------------------------------------------------------------------
-- 🛡️🛡️ الدرع المزدوج — مانع الموت تحت الأرض!
--------------------------------------------------------------------
local function startShield(hum)
    -- الدرع الأول: حاجز فوري (HealthChanged)
    -- أي نقص في الصحة → نرد القيمة الكاملة فوراً!
    pcall(function()
        shieldConn = hum.HealthChanged:Connect(function(health)
            if earthOn and health < hum.MaxHealth then
                hum.Health = hum.MaxHealth
            end
            if earthOn and health <= 0 then
                -- محاولة موت! نرد الحياة بالكامل فوراً!
                hum.Health = hum.MaxHealth
                hum:ChangeState(Enum.HumanoidStateType.GettingUp)
            end
        end)
    end)

    -- الدرع الثاني: نبض مستمر (Heartbeat كل إطار!)
    -- يرد الصحة حتى لو فشل الحاجز الأول!
    pcall(function()
        shieldBeat = RunService.Heartbeat:Connect(function()
            if earthOn and hum.Parent then
                if hum.Health < hum.MaxHealth then
                    hum.Health = hum.MaxHealth
                end
                if hum.Health <= 0 then
                    hum.Health = hum.MaxHealth
                end
            end
        end)
    end)
end

--------------------------------------------------------------------
-- إيقاف الدرع
--------------------------------------------------------------------
local function stopShield()
    if shieldConn then
        shieldConn:Disconnect()
        shieldConn = nil
    end
    if shieldBeat then
        shieldBeat:Disconnect()
        shieldBeat = nil
    end
end


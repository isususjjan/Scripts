btn.MouseButton1Click:Connect(function()
    speedOn = not speedOn
    if speedOn then
        btn.BackgroundColor3 = Color3.fromRGB(0, 150, 70)
        btn.Text = "⚡ MAX SPEED [ON]"
        setSpeed(true)
        notify("⚡ MAX SPEED ON!", "أنت أسرع من طيارة! حتى بالحمل! ✈️")
    else
        btn.BackgroundColor3 = Color3.fromRGB(45, 45, 60)
        btn.Text = "⚡ MAX SPEED [OFF]"
        setSpeed(false)
        notify("⚡ Speed OFF", "رجعت سرعتك الطبيعية", 3)
    end
end)


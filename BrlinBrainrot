local player = game.Players.LocalPlayer

local function getRoot()
    local char = player.Character or player.CharacterAdded:Wait()
    return char:WaitForChild("HumanoidRootPart")
end

--------------------------------------------------------------------
-- الانتقال
--------------------------------------------------------------------
local function tpTo(pos)
    pcall(function()
        local root = getRoot()
        root.Anchored = true
        task.wait()
        root.CFrame = CFrame.new(pos + Vector3.new(0, 4, 0))
        task.wait(0.1)
        root.Anchored = false
        local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
        if hum then hum:ChangeState(Enum.HumanoidStateType.GettingUp) end
    end)
end

local function notify(title, text)
    pcall(function()
        game.StarterGui:SetCore("SendNotification", {
            Title = title,
            Text = text,
            Duration = 5
        })
    end)
end

--------------------------------------------------------------------
-- ⚡ رادار الأساطير
--------------------------------------------------------------------
local watching = false
local grabUntil = 0
local known = {}

-- نسجل كل الحيوانات الموجودة حالياً
pcall(function()
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("RemoteEvent") and obj.Name == "Remote" and obj.Parent and obj.Parent:IsA("Model") then
            known[obj.Parent] = os.clock()
        end
    end
end)

local function onNewBrainrot(model)
    pcall(function()
        local pp = model:FindFirstChild("HumanoidRootPart")
            or model:FindFirstChildWhichIsA("BasePart")
        if pp then
            tpTo(pp.Position)
            notify("⚡ LEGENDARY!", "انتقلت إليه فوراً: " .. model.Name)
        end
    end)
end

-- رصد كل حيوان جديد يظهر في العالم
workspace.DescendantAdded:Connect(function(obj)
    pcall(function()
        if obj:IsA("RemoteEvent") and obj.Name == "Remote" then
            local model = obj.Parent
            if model and model:IsA("Model") and not known[model] then
                known[model] = os.clock()
                if watching and os.clock() <= grabUntil then
                    onNewBrainrot(model)
                end
            end
        end
    end)
end)

-- الاستماع لإشعار السيرفر (الذي رأيناه بالتجسس!)
pcall(function()
    local notif = game.ReplicatedStorage.Remotes:WaitForChild("Notification", 10)
    if notif then
        notif.OnClientEvent:Connect(function(text, color)
            if not watching then return end
            if typeof(text) == "string" then
                local lower = string.lower(text)
                if string.find(lower, "legendary", 1, true)
                    or string.find(lower, "mythic", 1, true)
                    or string.find(lower, "brainrot god", 1, true)
                    or string.find(lower, "secret", 1, true) then
                    grabUntil = os.clock() + 8
                    notify("⚡ " .. text, "جاري الإيجاد والانتقال فوراً...")
                    -- خطة احتياطية: بعد 3 ثواني ندور أحدث حيوان ظاهر
                    task.delay(3, function()
                        if not watching then return end
                        pcall(function()
                            local newest, newestTime = nil, 0
                            for _, obj in pairs(workspace:GetDescendants()) do
                                if obj:IsA("RemoteEvent") and obj.Name == "Remote"
                                    and obj.Parent and obj.Parent:IsA("Model") then
                                    local t = known[obj.Parent] or 0
                                    if t > newestTime and (os.clock() - t) < 15 then
                                        newest, newestTime = obj.Parent, t
                                    end
                                end
                            end
                            if newest then
                                onNewBrainrot(newest)
                            end
                        end)
                    end)
                end
            end
        end)
    end
end)


--------------------------------------------------------------------
-- إطفاء/تشغيل تصادم الشخصية
--------------------------------------------------------------------
local function setCharCollision(char, on)
    pcall(function()
        for _, part in pairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = on
            end
        end
    end)
end


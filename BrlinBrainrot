--------------------------------------------------------------------
-- ⏹️ stopDownEarth — الإيقاف النظيف الكامل!
--------------------------------------------------------------------
local function stopDownEarth()
    -- ١. نطفئ المفتاح الرئيسي (يوقف كل الحلقات والدرع تلقائياً!)
    earthOn = false

    -- ٢. نوقف حلقة المراقبة
    if earthConn then
        earthConn:Disconnect()
        earthConn = nil
    end

    -- ٣. نوقف الدرع
    stopShield()

    -- ٤. نحذف الأرضية الشبحية
    if undergroundFloor then
        undergroundFloor:Destroy()
        undergroundFloor = nil
    end

    -- ٥. ⬆️ نرفعك: نفس X/Z بالضبط — فقط Y يعود للفوق!
    pcall(function()
        local root = getRoot()
        local upY = savedEarthY or (root.Position.Y - UNDERGROUND_OFFSET)
        root.Anchored = true
        root.CFrame = CFrame.new(root.Position.X, upY, root.Position.Z)
        task.wait(0.15)
        root.Anchored = false
        
        -- ♻️ إعادة تشغيل التصادم — رجعت لاعب عادي فوق الأرض!
        setCharCollision(player.Character, true)
        
        local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
        if hum then hum:ChangeState(Enum.HumanoidStateType.GettingUp) end
    end)

    -- ٦. تذكير بديل Respawn (بيدك كما اخترت!)
    notify("⬆️ Back Up!", "لو السرعة بطيئة — اسوِ Respawn يدوياً 😄", 4)
end


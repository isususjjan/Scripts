-- ننزل على مراحل: كل خطوة 5 أمتار + فحص حياة!
local function findSafeDepth(startY)
    local ok, result = pcall(function()
        local root = getRoot()
        local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
        if not hum then return nil end

        local startYHealth = hum.Health
        local testY = startY
        local lastSafe = startY - 2  -- أول عمق آمن (2 متر فقط)

        for step = 1, 8 do
            testY = testY - 5  -- ننزل 5 أمتار إضافية
            root.Anchored = true
            root.CFrame = CFrame.new(root.Position.X, testY, root.Position.Z)
            task.wait(0.35)  -- ننتظر: هل اللعبة تقتلنا هنا؟

            -- فحص: هل نحن أحياء وصحتنا سليمة؟
            if hum.Health <= 0 or hum.Health < startYHealth - 1 then
                -- متنا أو تأذينا في هذا العمق! نرجع لآخر نقطة آمنة
                root.CFrame = CFrame.new(root.Position.X, lastSafe, root.Position.Z)
                return lastSafe
            end

            -- سليم؟ هذه نقطة آمنة جديدة!
            lastSafe = testY
            root.Anchored = false
            task.wait(0.05)
            root.Anchored = true
        end

        root.CFrame = CFrame.new(root.Position.X, lastSafe, root.Position.Z)
        return lastSafe
    end)
    if ok then return result end
    return startY - 2
end

local function startDownEarth()
    local root = getRoot()
    
    savedEarthY = root.Position.Y

    -- ⭐ نكتشف العمق الآمن تلقائياً!
    notify("🕳️ Down Earth", "جاري اكتشاف العمق الآمن...", 2)
    safeY = findSafeDepth(savedEarthY)
    undergroundY = safeY

    notify("🕳️ Safe Depth Found!", "العمق الآمن: " .. math.floor(savedEarthY - safeY) .. " متر ✅", 3)

    earthConn = RunService.Stepped:Connect(function()
        pcall(function()
            local char = player.Character
            if not char then return end
            local r = char:FindFirstChild("HumanoidRootPart")
            if not r then return end

            -- ١. قفل Y عند العمق الآمن!
            local pos = r.Position
            if math.abs(pos.Y - undergroundY) > 3 then
                r.CFrame = CFrame.new(pos.X, undergroundY, pos.Z)
            end

            -- ٢. إلغاء التصادم
            for _, part in pairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end

            -- ٣. السرعة الشرعية فقط (إن جمّدت!)
            pcall(function()
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum and hum.WalkSpeed == 0 then
                    hum.WalkSpeed = 16
                end
            end)

            -- ٤. 🛡️ حارس الحياة: لو صحتك بدأت تنقص → نرفعك فوراً!
            pcall(function()
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health < (hum.MaxHealth - 1) then
                    -- نحن نُهاجَم أو نحن في منطقة موت!
                    -- نرفعك فوق الأرض فوراً لحمايتك
                    stopDownEarth()
                end
            end)
        end)
    end)
end

local function stopDownEarth()
    if earthConn then
        earthConn:Disconnect()
        earthConn = nil
    end
    
    pcall(function()
        local root = getRoot()
        local upY = savedEarthY or (root.Position.Y + 20)
        root.Anchored = true
        root.CFrame = CFrame.new(root.Position.X, upY, root.Position.Z)
        task.wait(0.1)
        root.Anchored = false
        local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
        if hum then hum:ChangeState(Enum.HumanoidStateType.GettingUp) end
    end)

    notify("⬆️ Back Up!", "نفس المكان فوق الأرض ✅", 4)
end


local function updateStatus()
    Status.Text = SavedCFrame and "📍 Saved ✓" or "❌ No Save"
    Status.TextColor3 = SavedCFrame and Color3.fromRGB(0, 255, 127) or Color3.fromRGB(255, 80, 80)
end

-- زر متطور: يقبل الرفض (callback يرجع false = الزر يبقى OFF)
local function makeButton(text, yPos, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -16, 0, 38)
    btn.Position = UDim2.new(0, 8, 0, yPos)
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.BackgroundColor3 = Color3.fromRGB(45, 45, 60)
    btn.TextSize = 14
    btn.Parent = Frame

    local on = false
    btn.MouseButton1Click:Connect(function()
        if not on then
            local allowed = callback(true)
            if allowed == false then return end -- الطلب مرفوض! يبقى OFF
            on = true
            btn.BackgroundColor3 = Color3.fromRGB(0, 150, 70)
            btn.Text = string.gsub(text, "%[OFF%]", "[ON]")
        else
            callback(false)
            on = false
            btn.BackgroundColor3 = Color3.fromRGB(45, 45, 60)
            btn.Text = string.gsub(text, "%[ON%]", "[OFF]")
        end
    end)
end


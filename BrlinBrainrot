--   ⚡ MAX SPEED v2 — يشمل سرعة الحمل!
-- ═══════════════════════════════════════════════
local RunService = game:GetService("RunService")

local player = game.Players.LocalPlayer

-- ⚙️ السرعة (عدّل الرقم كما تحب: 100 هادئة، 150 سريعة، 200 صاروخ!)
local SPEED_VALUE = 150

local function notify(title, text)
    pcall(function()
        game.StarterGui:SetCore("SendNotification", {
            Title = title, Text = text, Duration = 3
        })
    end)
end

--------------------------------------------------------------------
-- ⚡ محرك السرعة
--------------------------------------------------------------------
local speedOn = false
local watchConn = nil
local beatConn = nil

-- نربط مراقبة لحظية على الـ Humanoid نفسه!
local function armHumanoid(hum)
    pcall(function()
        hum:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
            if speedOn and hum.WalkSpeed < SPEED_VALUE then
                hum.WalkSpeed = SPEED_VALUE
            end
        end)
        hum:GetPropertyChangedSignal("JumpPower"):Connect(function()
            if speedOn and hum.JumpPower < 120 then
                hum.JumpPower = 120
            end
        end)
    end)
end

-- تطبيق أقصى سرعة على الشخصية + الحيوان المحمول!
local function maxEverything(char)
    pcall(function()
        -- ١. سرعتك أنت
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum then
            if hum.WalkSpeed < SPEED_VALUE then hum.WalkSpeed = SPEED_VALUE end
            if hum.JumpPower < 120 then hum.JumpPower = 120 end
        end

        -- ٢. سرعة أي شيء محمول بيدك (الحيوان المسروق له Humanoid أيضاً أحياناً!)
        for _, obj in pairs(workspace:GetChildren()) do
            if obj:IsA("Model") then
                pcall(function()
                    -- هل هذا الحيوان مربوط بجسدك (أنت حامله)؟
                    local weld = obj:FindFirstChildWhichIsA("Weld", true)
                        or obj:FindFirstChildWhichIsA("WeldConstraint", true)
                    if weld then
                        local myRoot = char:FindFirstChild("HumanoidRootPart")
                        if myRoot and (weld.Part0 == myRoot or weld.Part1 == myRoot) then
                            local hisHum = obj:FindFirstChildOfClass("Humanoid")
                            if hisHum and hisHum.WalkSpeed < SPEED_VALUE then
                                hisHum.WalkSpeed = SPEED_VALUE
                            end
                        end
                    end
                end)
            end
        end

        -- ٣. كسر قيود الحمل (BodyVelocity البطيء!)
        for _, v in pairs(char:GetDescendants()) do
            if v:IsA("BodyVelocity") then
                v.MaxForce = Vector3.new(1e9, 1e9, 1e9)
            end
        end
    end)
end

local function setSpeed(on)
    -- فك كل المراقبات القديمة
    if watchConn then watchConn:Disconnect(); watchConn = nil end
    if beatConn then beatConn:Disconnect(); beatConn = nil end

    if on then
        -- ١. سلاح جسدك الحالي
        pcall(function()
            local char = player.Character
            if char then
                maxEverything(char)
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum then armHumanoid(hum) end
            end
        end)

        -- ٢. حراسة كل إطار (60 مرة بالثانية!)
        beatConn = RunService.Heartbeat:Connect(function()
            pcall(function()
                local char = player.Character
                if char then maxEverything(char) end
            end)
        end)

        -- ٣. حراسة الشخصية الجديدة عند Respawn
        player.CharacterAdded:Connect(function(char)
            if not speedOn then return end
            task.wait(0.5)
            maxEverything(char)
            pcall(function() armHumanoid(char:WaitForChild("Humanoid")) end)
        end)

        -- ٤. راقب أي Humanoid جديد يظهر في العالم (الحيوانات المنسوخة!)
        watchConn = workspace.DescendantAdded:Connect(function(obj)
            if not speedOn then return end
            if obj:IsA("Humanoid") then
                task.wait(0.1)
                armHumanoid(obj)
                pcall(function()
                    if obj.WalkSpeed < SPEED_VALUE and obj.WalkSpeed > 0 then
                        obj.WalkSpeed = SPEED_VALUE
                    end
                end)
            end
        end)
    else
        -- إيقاف: نرجع الطبيعي
        pcall(function()
            local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
            if hum then
                hum.WalkSpeed = 16
                hum.JumpPower = 50
            end
        end)
    end
end


-- Infinity Jump (لا نهائي!)
--------------------------------------------------------------------
local jumpOn = false
local jumpConn = nil

local function setupJumpMonitor(hum)
    hum.StateChanged:Connect(function(old, new)
        if new == Enum.HumanoidStateType.Landed then
            -- لا عدّاد — القفز لا نهائي!
        end
    end)
end

local function startInfinityJump()
    pcall(function()
        local char = player.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then
                setupJumpMonitor(hum)

                jumpConn = UserInputService.JumpRequest:Connect(function()
                    if not jumpOn then
                        return
                    end
                    pcall(function()
                        local c = player.Character
                        if not c then
                            return
                        end
                        local h = c:FindFirstChildOfClass("Humanoid")
                        local r = c:FindFirstChild("HumanoidRootPart")
                        if not h or not r then
                            return
                        end

                        local state = h:GetState()
                        local inAir = state == Enum.HumanoidStateType.Freefall
                            or state == Enum.HumanoidStateType.Jumping

                        -- قفزات لا نهائية! لا حد!
                        if inAir then
                            r.AssemblyLinearVelocity = Vector3.new(
                                r.AssemblyLinearVelocity.X,
                                h.JumpPower,
                                r.AssemblyLinearVelocity.Z
                            )
                            h:ChangeState(Enum.HumanoidStateType.Jumping)
                        end
                    end)
                end)

                player.CharacterAdded:Connect(function(newChar)
                    if jumpOn then
                        task.wait(1)
                        pcall(function()
                            local newHum = newChar:WaitForChild("Humanoid")
                            setupJumpMonitor(newHum)
                        end)
                    end
                end)
            end
        end
    end)
end

local function stopInfinityJump()
    if jumpConn then
        jumpConn:Disconnect()
        jumpConn = nil
    end
end

--------------------------------------------------------------------
-- Speed Steal — أزرار سرقة فورية بدون تحميل!
--------------------------------------------------------------------
local stealOn = false
local stealLoopConn = nil
local stealAddConn = nil

local function makePromptInstant(prompt)
    pcall(function()
        prompt.HoldDuration = 0
    end)
end

local function hookAllPrompts()
    -- نصفّر كل الأزرار الموجودة
    pcall(function()
        for _, obj in pairs(workspace:GetDescendants()) do
            if obj:IsA("ProximityPrompt") then
                makePromptInstant(obj)
            end
        end
    end)

    -- ونراقب الأزرار الجديدة التي تظهر!
    stealAddConn = workspace.DescendantAdded:Connect(function(obj)
        if stealOn and obj:IsA("ProximityPrompt") then
            makePromptInstant(obj)
        end
    end)

    -- حلقة دائمة: أي زر يرجّع مدته؟ نصفّره فوراً!
    stealLoopConn = task.spawn(function()
        while stealOn do
            pcall(function()
                for _, obj in pairs(workspace:GetDescendants()) do
                    if obj:IsA("ProximityPrompt") and obj.HoldDuration ~= 0 then
                        obj.HoldDuration = 0
                    end
                end
            end)
            task.wait(0.5)
        end
    end)
end

local function startSpeedSteal()
    hookAllPrompts()
    notify("👀 Speed Steal ON!", "كل أزرار السرقة فورية! ⚡", 3)
end

local function stopSpeedSteal()
    if stealAddConn then
        stealAddConn:Disconnect()
        stealAddConn = nil
    end
    stealLoopConn = nil
    notify("👀 Speed Steal OFF", "الأزرار رجعت عادية", 3)
end


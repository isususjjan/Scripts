local player = game.Players.LocalPlayer

local function getRoot()
    local char = player.Character or player.CharacterAdded:Wait()
    return char:WaitForChild("HumanoidRootPart")
end

--------------------------------------------------------------------
-- 🔍 إيجاد لوحك الأصفر (قاعدتك أنت فقط!)
--------------------------------------------------------------------
local function findMyYellowPad()
    local result = nil
    pcall(function()
        local myName = string.lower(player.Name)
        local dispName = string.lower(player.DisplayName or "")
        
        -- ١. نجد قاعدتك عبر لافتة اسمك
        local myBase = nil
        for _, obj in pairs(workspace:GetDescendants()) do
            if obj:IsA("TextLabel") then
                local txt = ""
                pcall(function() txt = string.lower(obj.Text or "") end)
                if (myName ~= "" and txt:find(myName, 1, true))
                    or (dispName ~= "" and txt:find(dispName, 1, true)) then
                    local base = obj
                    for _ = 1, 5 do
                        if base.Parent and base.Parent ~= workspace then
                            base = base.Parent
                        else
                            break
                        end
                    end
                    if base ~= workspace then
                        myBase = base
                        break
                    end
                end
            end
        end

        -- ٢. في قاعدتك: ندور على Part أصفر (اللوح!)
        if myBase then
            pcall(function()
                for _, part in pairs(myBase:GetDescendants()) do
                    if part:IsA("BasePart") then
                        local isYellow = false
                        pcall(function()
                            -- الأصفر: أحمر عالي + أخضر عالي + أزرق منخفض
                            if part.Color.R > 0.7 and part.Color.G > 0.6 and part.Color.B < 0.4 then
                                isYellow = true
                            end
                        end)
                        if isYellow then
                            result = {
                                pad = part,
                                name = part.Name
                            }
                            return
                        end
                    end
                end
            end)
        end

        -- ٣. احتياط: أقرب Part أصفر لموقعك (وأنت داخل قاعدتك!)
        if result == nil then
            pcall(function()
                local myPos = getRoot().Position
                local bestDist = 100
                for _, part in pairs(workspace:GetDescendants()) do
                    if part:IsA("BasePart") then
                        local isYellow = false
                        pcall(function()
                            if part.Color.R > 0.7 and part.Color.G > 0.6 and part.Color.B < 0.4
                                and part.Transparency < 0.7 and part.Size.Magnitude < 30 then
                                isYellow = true
                            end
                        end)
                        if isYellow then
                            local dist = (part.Position - myPos).Magnitude
                            if dist < bestDist then
                                bestDist = dist
                                result = {
                                    pad = part,
                                    name = part.Name,
                                    dist = math.floor(dist)
                                }
                            end
                        end
                    end
                end
            end)
        end
    end)
    return result
end

--------------------------------------------------------------------
-- 🔥 الحدث اللمسي عن بعد!
--------------------------------------------------------------------
local function remoteTouch(pad)
    local ok, err = pcall(function()
        local root = getRoot()
        local char = player.Character
        if not char then return end
        
        -- نجمع أجزاء جسدك الحقيقية
        local touched = false
        for _, part in pairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                pcall(function()
                    firetouchinterest(part, pad, 0) -- بداية لمس
                    touched = true
                end)
            end
        end
        task.wait(0.15)
        for _, part in pairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                pcall(function()
                    firetouchinterest(part, pad, 1) -- نهاية لمس
                end)
            end
        end
        return touched
    end)
    return ok
end

-- الطريقة ٢: TP الدقيق (0.2 ثانية فقط!)
local function quickTouchPad(pad)
    local ok = pcall(function()
        local root = getRoot()
        local oldCF = root.CFrame
        root.Anchored = true
        root.CFrame = pad.CFrame + Vector3.new(0, 2, 0)
        task.wait(0.2)
        root.CFrame = oldCF
        task.wait(0.05)
        root.Anchored = false
    end)
    return ok
end

--------------------------------------------------------------------
-- الحالة + الحلقة
--------------------------------------------------------------------
local autoLockOn = false
local lockThread = nil

local function autoLockLoop()
    task.spawn(function()
        game.StarterGui:SetCore("SendNotification", {
            Title = "🔒 Auto Lock",
            Text = "جاري البحث عن لوحك الأصفر...",
            Duration = 4
        })

        local padInfo = findMyYellowPad()

        if not padInfo then
            game.StarterGui:SetCore("SendNotification", {
                Title = "❌ Auto Lock",
                Text = "لم أجد اللوح الأصفر! قف داخل قاعدتك وأعد المحاولة",
                Duration = 5
            })
            autoLockOn = false
            return
        end

        local pad = padInfo.pad
        game.StarterGui:SetCore("SendNotification", {
            Title = "✅ Yellow Pad Found!",
            Text = padInfo.name .. (padInfo.dist and (" 📏" .. padInfo.dist .. "m") or " ✅"),
            Duration = 4
        })

        -- ١. أول قفل فوري (عن بعد!)
        local method1 = remoteTouch(pad)
        if not method1 then
            quickTouchPad(pad)
        end
        game.StarterGui:SetCore("SendNotification", {
            Title = "🔒 First Lock!",
            Text = "تم القفل الأول! (الطريقة: " .. (method1 and "fire touch" or "quick tp") .. ")",
            Duration = 4
        })

        -- ٢. الحلقة: نراقب اللوح — انطفأ الأصفر = انتهى الوقت → نعيد الدوس!
        while autoLockOn do
            task.wait(2)

            local padExists = false
            local stillYellow = false
            pcall(function()
                if pad and pad.Parent then
                    padExists = true
                    -- هل ما زال أصفر مشعاً؟
                    if pad.Color.R > 0.6 and pad.Color.G > 0.5 and pad.Transparency < 0.8 then
                        stillYellow = true
                    end
                end
            end)

            -- انتهى القفل! (اللوح اختفى أو فقد لونه أو انطفأ)
            if (not padExists) or (not stillYellow) then
                addLog = addLog -- (بدون شيء)
                game.StarterGui:SetCore("SendNotification", {
                    Title = "🔒 Re-Locking!",
                    Text = "انتهى وقت القفل — نعيد التنشيط عن بعد! ⚡",
                    Duration = 2
                })

                -- نعيد المحاولة بالطريقتين!
                local ok1 = remoteTouch(pad)
                if not ok1 then
                    quickTouchPad(pad)
                end

                -- ننتظر حتى يشتغل القفل مجدداً
                task.wait(3)
            end
        end
    end)
end


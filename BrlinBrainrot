local function findBrainrots()
    local list = {}
    pcall(function()
        local myPos = getRoot().Position
        for _, obj in pairs(workspace:GetDescendants()) do
            if obj:IsA("RemoteEvent") and obj.Name == "Remote" then
                local model = obj.Parent
                if model and model:IsA("Model") then
                    local pp = model:FindFirstChild("HumanoidRootPart")
                        or model:FindFirstChildWhichIsA("BasePart")
                    local dist = 0
                    if pp then
                        dist = math.floor((pp.Position - myPos).Magnitude)
                    end
                    table.insert(list, {
                        model = model,
                        remote = obj,
                        name = model.Name,
                        dist = dist
                    })
                end
            end
        end
        -- ترتيب من الأقرب للأبعد
        table.sort(list, function(a, b) return a.dist < b.dist end)
    end)
    return list
end

local function attemptSteal(entry)
    local ok, err = pcall(function()
        entry.remote:FireServer("Stolen")
    end)
    game.StarterGui:SetCore("SendNotification", {
        Title = ok and "🧠 Steal Sent!" or "❌ Failed",
        Text = ok and (entry.name .. " ← Stolen ✅") or tostring(err):sub(1, 50),
        Duration = 3
    })
end


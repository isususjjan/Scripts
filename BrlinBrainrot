local player = game.Players.LocalPlayer

-- دالة جلب جذر الجسد بأمان
local function getRoot()
    local char = player.Character or player.CharacterAdded:Wait()
    return char:WaitForChild("HumanoidRootPart")
end

--------------------------------------------------------------------
-- نظام الحفظ الدائم (ملف على جهازك!)
--------------------------------------------------------------------
local SAVE_FILE = "BrlinTP.txt"
local SavedCFrame = nil

if writefile and readfile and isfile and isfile(SAVE_FILE) then
    local ok, data = pcall(function()
        return game:GetService("HttpService"):JSONDecode(readfile(SAVE_FILE))
    end)
    if ok and data then
        SavedCFrame = CFrame.new(data[1], data[2], data[3])
    end
end

local function saveCFrame(cf)
    SavedCFrame = cf
    if writefile then
        pcall(function()
            local pos = cf.Position
            writefile(SAVE_FILE, game:GetService("HttpService"):JSONEncode({pos.X, pos.Y, pos.Z}))
        end)
    end
end

local function clearCFrame()
    SavedCFrame = nil
    if writefile and isfile and isfile(SAVE_FILE) then
        pcall(function() delfile(SAVE_FILE) end)
    end
end

--------------------------------------------------------------------
-- 🛡️ Stay Inside — مضاد الطرد من القواعد المقفولة!
--------------------------------------------------------------------
local stayOn = false
local stayThread = nil

local function toggleStay(on)
    stayOn = on
    if stayThread then
        task.cancel(stayThread)
        stayThread = nil
    end
    if on then
        stayThread = task.spawn(function()
            while stayOn do
                pcall(function()
                    local root = getRoot()
                    if SavedCFrame and root and root.Parent then
                        local dist = (root.Position - SavedCFrame.Position).Magnitude
                        if dist > 25 then
                            root.Anchored = true
                            root.CFrame = SavedCFrame + Vector3.new(0, 3, 0)
                            task.wait(0.05)
                            root.Anchored = false
                        end
                    end
                end)
                task.wait(0.1)
            end
        end)
    end
end

--------------------------------------------------------------------
-- 🔍 Spy — كاشف الأزرار السرية (Remotes)
--------------------------------------------------------------------
local spyResults = {}

local function runSpy()
    spyResults = {}
    local function scan(folder, path, depth)
        if depth > 4 then return end
        local ok = pcall(function()
            for _, obj in pairs(folder:GetChildren()) do
                if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
                    table.insert(spyResults, path .. "/" .. obj.Name .. " [" .. obj.ClassName .. "]")
                end
                scan(obj, path .. "/" .. obj.Name, depth + 1)
            end
        end)
    end
    scan(game.ReplicatedStorage, "RS", 0)
    return #spyResults
end

local function showSpyResults()
    local ok, err = pcall(function()
        runSpy()
        local frame = game.CoreGui:FindFirstChild("BrlinGui") and game.CoreGui.BrlinGui:FindFirstChild("SpyFrame")
        if frame then frame:Destroy() end

        local SF = Instance.new("Frame")
        SF.Name = "SpyFrame"
        SF.Size = UDim2.new(0, 300, 0, 350)
        SF.Position = UDim2.new(0, 260, 0, 200)
        SF.BackgroundColor3 = Color3.fromRGB(15, 15, 25)
        SF.Active = true
        SF.Draggable = true
        SF.Parent = game.CoreGui.BrlinGui

        local STitle = Instance.new("TextLabel")
        STitle.Size = UDim2.new(1, 0, 0, 30)
        STitle.Text = "🔍 Spy — " .. #spyResults .. " Secrets"
        STitle.TextColor3 = Color3.fromRGB(255, 220, 0)
        STitle.BackgroundTransparency = 1
        STitle.TextSize = 14
        STitle.Parent = SF

        local Scroll = Instance.new("ScrollingFrame")
        Scroll.Size = UDim2.new(1, -10, 1, -40)
        Scroll.Position = UDim2.new(0, 5, 0, 35)
        Scroll.BackgroundColor3 = Color3.fromRGB(10, 10, 18)
        Scroll.ScrollBarThickness = 6
        Scroll.CanvasSize = UDim2.new(0, 0, 0, #spyResults * 22)
        Scroll.Parent = SF

        for i, line in ipairs(spyResults) do
            local lbl = Instance.new("TextLabel")
            lbl.Size = UDim2.new(1, -8, 0, 22)
            lbl.Position = UDim2.new(0, 4, 0, (i - 1) * 22)
            lbl.Text = line
            lbl.TextColor3 = Color3.fromRGB(180, 255, 180)
            lbl.BackgroundTransparency = 1
            lbl.TextSize = 12
            lbl.TextXAlignment = Enum.TextXAlignment.Left
            lbl.Parent = Scroll
        end
    end)
    if not ok then
        game.StarterGui:SetCore("SendNotification", {
            Title = "Spy ❌",
            Text = tostring(err):sub(1, 60),
            Duration = 4
        })
    end
end


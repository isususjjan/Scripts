--------------------------------------------------------------------
-- 🕳️ startDownEarth — البدء الكامل (مصحح!):
-- نزول مباشر + تصادم مطفأ أولاً + أرضية شبحية + Y-Lock + الدرع!
--------------------------------------------------------------------
local function startDownEarth()
    pcall(function()
        savedEarthY = getRoot().Position.Y
    end)

    task.spawn(function()
        pcall(function()
            local root = getRoot()
            undergroundY = (savedEarthY or root.Position.Y) + UNDERGROUND_OFFSET

            -- ١. الأرضية الشبحية أولاً — تنتظرك تحت!
            if not undergroundFloor then
                undergroundFloor = Instance.new("Part")
                undergroundFloor.Name = "BrlinGhostFloor"
                undergroundFloor.Size = Vector3.new(15, 1, 15)
                undergroundFloor.Transparency = 1
                undergroundFloor.Anchored = true
                undergroundFloor.CanCollide = true
                undergroundFloor.Parent = workspace
            end
            undergroundFloor.CFrame = CFrame.new(root.Position.X, undergroundY - 3.5, root.Position.Z)

            -- ٢. ⭐ التصادم يُطفأ أولاً — حتى لا تقاومنا الأرض!
            setCharCollision(player.Character, false)

            -- ٣. النزول المباشر (نمط v1.3 المجرب!)
            root.Anchored = true
            root.CFrame = CFrame.new(root.Position.X, undergroundY, root.Position.Z)
            task.wait(0.15)
            root.Anchored = false

            -- ٤. الحلقة الدائمة
            if earthConn then earthConn:Disconnect() end
            earthConn = RunService.Stepped:Connect(function()
                pcall(function()
                    local c = player.Character
                    if not c then return end
                    local r = c:FindFirstChild("HumanoidRootPart")
                    if not r then return end

                    -- التصادم يبقى مطفأً (تعبر كل شيء!)
                    for _, part in pairs(c:GetDescendants()) do
                        if part:IsA("BasePart") then
                            part.CanCollide = false
                        end
                    end

                    -- الأرضية الشبحية تلاحق قدميك (مشي طبيعي!)
                    if undergroundFloor and undergroundFloor.Parent then
                        undergroundFloor.CFrame = CFrame.new(
                            r.Position.X,
                            undergroundY - 3.5,
                            r.Position.Z
                        )
                    end

                    -- ⭐ Y-Lock — سر v1.4! السيرفر يرفعك؟ نرجعك فوراً!
                    local pos = r.Position
                    if math.abs(pos.Y - undergroundY) > 3 then
                        r.CFrame = CFrame.new(pos.X, undergroundY, pos.Z)
                    end

                    -- 🛡️ درع إضافي داخل الحلقة: الصحة لا تنقص أبداً!
                    pcall(function()
                        local hum = c:FindFirstChildOfClass("Humanoid")
                        if hum and hum.Health < hum.MaxHealth then
                            hum.Health = hum.MaxHealth
                        end
                    end)
                end)
            end)

            -- ٥. 🛡️🛡️ تفعيل الدرع المزدوج الرسمي!
            local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
            if hum then startShield(hum) end
        end)
    end)

    -- ٦. بعد Respawn اليدوي (أنت تسويه بيدك!) — نغوصك من جديد تلقائياً!
    player.CharacterAdded:Connect(function(char)
        if not earthOn then return end
        task.wait(1)
        pcall(function()
            local root = char:WaitForChild("HumanoidRootPart", 5)
            undergroundY = (savedEarthY or root.Position.Y) + UNDERGROUND_OFFSET

            if undergroundFloor then undergroundFloor:Destroy() end
            undergroundFloor = Instance.new("Part")
            undergroundFloor.Name = "BrlinGhostFloor"
            undergroundFloor.Size = Vector3.new(15, 1, 15)
            undergroundFloor.Transparency = 1
            undergroundFloor.Anchored = true
            undergroundFloor.CanCollide = true
            undergroundFloor.Parent = workspace
            undergroundFloor.CFrame = CFrame.new(root.Position.X, undergroundY - 3.5, root.Position.Z)

            setCharCollision(char, false)

            root.Anchored = true
            root.CFrame = CFrame.new(root.Position.X, undergroundY, root.Position.Z)
            task.wait(0.15)
            root.Anchored = false

            local hum = char:WaitForChild("Humanoid", 5)
            if hum then startShield(hum) end
        end)
    end)

    notify("🕳️ Diving!", "الدرع المزدوج 🛡️🛡️ مفعّل — لا موت تحت!", 4)
end


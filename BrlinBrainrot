local player = game.Players.LocalPlayer
local RunService = game:GetService("RunService")

local function getRoot()
    local char = player.Character or player.CharacterAdded:Wait()
    return char:WaitForChild("HumanoidRootPart")
end

local function notify(title, text, dur)
    pcall(function()
        game.StarterGui:SetCore("SendNotification", {
            Title = title, Text = text, Duration = dur or 3
        })
    end)
end

--------------------------------------------------------------------
-- ⚙️ الإعدادات
--------------------------------------------------------------------
local RECHECK_EVERY = 2      -- فحص الليزر كل ثانيتين
local FALLBACK_RETOUCH = 20  -- احتياط: إعادة دوس كل 20 ثانية إن لم نجد ليزر

--------------------------------------------------------------------
-- 🔍 التقاط اللوح — من تحت قدميك مباشرة!
--------------------------------------------------------------------
local function findPadUnderFeet()
    local best = nil
    local bestSize = math.huge
    pcall(function()
        local myPos = getRoot().Position
        for _, part in pairs(workspace:GetDescendants()) do
            if part:IsA("BasePart") and part.Parent then
                pcall(function()
                    local dx = math.abs(part.Position.X - myPos.X)
                    local dz = math.abs(part.Position.Z - myPos.Z)
                    local dy = myPos.Y - part.Position.Y
                    -- تحت قدميك مباشرة + ليس الأرضية الضخمة
                    if dx < 6 and dz < 6 and dy > -4 and dy < 7 then
                        local sz = part.Size.Magnitude
                        if sz < 30 and sz < bestSize then
                            bestSize = sz
                            best = part
                        end
                    end
                end)
            end
        end
    end)
    return best
end

--------------------------------------------------------------------
-- 🔥 الدوس عن بُعد (firetouchinterest!)
--------------------------------------------------------------------
local function remoteTouch(pad)
    local ok = pcall(function()
        local char = player.Character
        if not char then return end
        for _, part in pairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                firetouchinterest(part, pad, 0)
            end
        end
        task.wait(0.15)
        for _, part in pairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                firetouchinterest(part, pad, 1)
            end
        end
    end)
    return ok
end

-- احتياط: وثبة خاطفة (0.25 ثانية!)
local function quickTouch(padPos)
    local ok = pcall(function()
        local root = getRoot()
        local old = root.CFrame
        root.Anchored = true
        root.CFrame = CFrame.new(padPos + Vector3.new(0, 2.5, 0))
        task.wait(0.25)
        root.CFrame = old
        task.wait(0.05)
        root.Anchored = false
    end)
    return ok
end

--------------------------------------------------------------------
-- 🔴 مراقبة جدران الليزر (مؤشر انتهاء القفل!)
--------------------------------------------------------------------
local function snapshotLasers(padPos)
    local lasers = {}
    pcall(function()
        for _, part in pairs(workspace:GetDescendants()) do
            if part:IsA("BasePart") then
                pcall(function()
                    if part.Color.R > 0.6 and part.Color.G < 0.35 and part.Color.B < 0.35
                        and (part.Position - padPos).Magnitude < 120
                        and part.Size.Magnitude < 60 then
                        table.insert(lasers, part)
                    end
                end)
            end
        end
    end)
    return lasers
end

local function lasersAlive(lasers)
    local alive = 0
    for _, part in pairs(lasers) do
        pcall(function()
            if part.Parent ~= nil then alive = alive + 1 end
        end)
    end
    return alive
end

--------------------------------------------------------------------
-- الحالة
--------------------------------------------------------------------
local autoLockOn = false

--------------------------------------------------------------------
-- 🔒 حلقة الحماية الدائمة
--------------------------------------------------------------------
local function autoLockLoop()
    task.spawn(function()
        notify("🔒 Auto Lock", "جاري التقاط اللوح من تحت قدميك...")

        local pad = findPadUnderFeet()
        if not pad then
            notify("❌ Auto Lock", "قف فوق الضوء الأصفر نفسه ثم فعّل الزر!", 5)
            autoLockOn = false
            return
        end

        local padPos = pad.Position
        notify("✅ Pad Locked On!", "تم التقاط اللوح — جاري القفل الأول...", 3)

        -- القفل الأول
        local ok1 = remoteTouch(pad)
        if not ok1 then quickTouch(padPos) end
        task.wait(1.5)

        -- التقاط الليزر بعد القفل
        local lasers = snapshotLasers(padPos)
        local useLasers = #lasers > 0

        if useLasers then
            notify("🛡️ محمي!", "سأعيد القفل لحظة انتهاء المدة تلقائياً — اذهب اسرق! ⚡", 5)
        else
            notify("🛡️ محمي!", "سأعيد القفل كل " .. FALLBACK_RETOUCH .. " ثانية — اذهب اسرق! ⚡", 5)
        end

        local lastTouch = os.clock()

        -- الحلقة الدائمة
        while autoLockOn do
            task.wait(RECHECK_EVERY)

            local expired = false
            if useLasers then
                if lasersAlive(lasers) == 0 then
                    expired = true
                end
            end

            local timedOut = (os.clock() - lastTouch) >= FALLBACK_RETOUCH

            if expired or (not useLasers and timedOut) then
                notify("🔒 Re-Locking!", "انتهى القفل — أعيد تنشيطه عن بُعد! ⚡", 2)

                local ok = remoteTouch(pad)
                if not ok then quickTouch(padPos) end
                lastTouch = os.clock()

                if useLasers then
                    task.wait(2)
                    lasers = snapshotLasers(padPos)
                    if #lasers == 0 then
                        useLasers = false -- الليزر لم يعد يظهر — نتحول للمؤقت
                    end
                end
            end
        end
    end)
end


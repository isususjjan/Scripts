local player = game.Players.LocalPlayer
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local function getRoot()
    local char = player.Character or player.CharacterAdded:Wait()
    return char:WaitForChild("HumanoidRootPart")
end

local function notify(title, text, dur)
    pcall(function()
        game.StarterGui:SetCore("SendNotification", {
            Title = title,
            Text = text,
            Duration = dur or 3
        })
    end)
end

--------------------------------------------------------------------
-- Teleport
--------------------------------------------------------------------
local SAVE_FILE = "BrlinTP.txt"
local SavedCFrame = nil

if writefile and readfile and isfile and isfile(SAVE_FILE) then
    local ok, data = pcall(function()
        return game:GetService("HttpService"):JSONDecode(readfile(SAVE_FILE))
    end)
    if ok and data then
        SavedCFrame = CFrame.new(data[1], data[2], data[3])
    end
end

local function saveCFrame(cf)
    SavedCFrame = cf
    if writefile then
        pcall(function()
            local pos = cf.Position
            writefile(SAVE_FILE, game:GetService("HttpService"):JSONEncode({pos.X, pos.Y, pos.Z}))
        end)
    end
end

local function clearCFrame()
    SavedCFrame = nil
    if writefile and isfile and isfile(SAVE_FILE) then
        pcall(function()
            delfile(SAVE_FILE)
        end)
    end
end

--------------------------------------------------------------------
-- Down Earth
--------------------------------------------------------------------
local earthOn = false
local earthConn = nil
local shieldConn = nil
local shieldBeat = nil
local undergroundFloor = nil
local savedEarthY = nil
local undergroundY = nil
local UNDERGROUND_OFFSET = -8

local function setCharCollision(char, on)
    pcall(function()
        for _, part in pairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = on
            end
        end
    end)
end

local function startShield(hum)
    pcall(function()
        shieldConn = hum.HealthChanged:Connect(function(health)
            if earthOn and health < hum.MaxHealth then
                hum.Health = hum.MaxHealth
            end
            if earthOn and health <= 0 then
                hum.Health = hum.MaxHealth
                hum:ChangeState(Enum.HumanoidStateType.GettingUp)
            end
        end)
    end)

    pcall(function()
        shieldBeat = RunService.Heartbeat:Connect(function()
            if earthOn and hum.Parent then
                if hum.Health < hum.MaxHealth then
                    hum.Health = hum.MaxHealth
                end
                if hum.Health <= 0 then
                    hum.Health = hum.MaxHealth
                end
            end
        end)
    end)
end

local function stopShield()
    if shieldConn then
        shieldConn:Disconnect()
        shieldConn = nil
    end
    if shieldBeat then
        shieldBeat:Disconnect()
        shieldBeat = nil
    end
end

local function riseToSurface()
    if earthConn then
        earthConn:Disconnect()
        earthConn = nil
    end
    if undergroundFloor then
        undergroundFloor:Destroy()
        undergroundFloor = nil
    end
    stopShield()
    pcall(function()
        local root = getRoot()
        local upY = savedEarthY or (root.Position.Y - UNDERGROUND_OFFSET)
        root.Anchored = true
        root.CFrame = CFrame.new(root.Position.X, upY, root.Position.Z)
        task.wait(0.15)
        root.Anchored = false
        setCharCollision(player.Character, true)
        local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
        if hum then
            hum:ChangeState(Enum.HumanoidStateType.GettingUp)
        end
    end)
end

local function startDownEarth()
    pcall(function()
        savedEarthY = getRoot().Position.Y
    end)

    task.spawn(function()
        pcall(function()
            local root = getRoot()
            undergroundY = (savedEarthY or root.Position.Y) + UNDERGROUND_OFFSET

            if not undergroundFloor then
                undergroundFloor = Instance.new("Part")
                undergroundFloor.Name = "BrlinGhostFloor"
                undergroundFloor.Size = Vector3.new(15, 1, 15)
                undergroundFloor.Transparency = 1
                undergroundFloor.Anchored = true
                undergroundFloor.CanCollide = true
                undergroundFloor.Parent = workspace
            end
            undergroundFloor.CFrame = CFrame.new(root.Position.X, undergroundY - 3.5, root.Position.Z)

            setCharCollision(player.Character, false)

            root.Anchored = true
            root.CFrame = CFrame.new(root.Position.X, undergroundY, root.Position.Z)
            task.wait(0.15)
            root.Anchored = false

            if earthConn then
                earthConn:Disconnect()
            end
            earthConn = RunService.Stepped:Connect(function()
                pcall(function()
                    local c = player.Character
                    if not c then
                        return
                    end
                    local r = c:FindFirstChild("HumanoidRootPart")
                    if not r then
                        return
                    end

                    for _, part in pairs(c:GetDescendants()) do
                        if part:IsA("BasePart") then
                            part.CanCollide = false
                        end
                    end

                    if undergroundFloor and undergroundFloor.Parent then
                        undergroundFloor.CFrame = CFrame.new(r.Position.X, undergroundY - 3.5, r.Position.Z)
                    end

                    local pos = r.Position
                    if math.abs(pos.Y - undergroundY) > 3 then
                        r.CFrame = CFrame.new(pos.X, undergroundY, pos.Z)
                    end

                    pcall(function()
                        local hum = c:FindFirstChildOfClass("Humanoid")
                        if hum and hum.Health < hum.MaxHealth then
                            hum.Health = hum.MaxHealth
                        end
                    end)
                end)
            end)

            local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
            if hum then
                startShield(hum)
            end
        end)
    end)

    player.CharacterAdded:Connect(function(char)
        if not earthOn then
            return
        end
        task.wait(1)
        pcall(function()
            local root = char:WaitForChild("HumanoidRootPart", 5)
            undergroundY = (savedEarthY or root.Position.Y) + UNDERGROUND_OFFSET

            if undergroundFloor then
                undergroundFloor:Destroy()
            end
            undergroundFloor = Instance.new("Part")
            undergroundFloor.Name = "BrlinGhostFloor"
            undergroundFloor.Size = Vector3.new(15, 1, 15)
            undergroundFloor.Transparency = 1
            undergroundFloor.Anchored = true
            undergroundFloor.CanCollide = true
            undergroundFloor.Parent = workspace
            undergroundFloor.CFrame = CFrame.new(root.Position.X, undergroundY - 3.5, root.Position.Z)

            setCharCollision(char, false)

            root.Anchored = true
            root.CFrame = CFrame.new(root.Position.X, undergroundY, root.Position.Z)
            task.wait(0.15)
            root.Anchored = false

            local hum = char:WaitForChild("Humanoid", 5)
            if hum then
                startShield(hum)
            end
        end)
    end)

    notify("🕳️ Diving!", "الدرع المزدوج مفعّل — لا موت تحت!", 4)
end

local function stopDownEarth()
    earthOn = false

    if earthConn then
        earthConn:Disconnect()
        earthConn = nil
    end

    riseToSurface()

    notify("⬆️ Back Up!", "نفس المكان فوق الأرض ✅", 4)
end


-- ١. زر Set — حفظ المكان الحالي
makeButton("📍  Set", 55, function()
    local root = getRoot()
    saveCFrame(root.CFrame)
    updateStatus()
    game.StarterGui:SetCore("SendNotification", {
        Title = "📍 Saved!",
        Text = "Position saved permanently ✅",
        Duration = 3
    })
end)

-- ٢. زر Tp — الانتقال للمكان المحفوظ
makeButton("🚀  Tp", 98, function()
    if SavedCFrame == nil then
        game.StarterGui:SetCore("SendNotification", {
            Title = "❌ No Save!",
            Text = "اضغط Set أولاً لحفظ مكان",
            Duration = 3
        })
        return
    end
    local root = getRoot()
    local char = player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    -- نطفئ السقوط الكامل لحظة النقل حتى لا نسقط بالخطأ
    local oldState = hum and hum:GetState()
    root.Anchored = true
    task.wait()
    root.CFrame = SavedCFrame + Vector3.new(0, 3, 0)
    task.wait(0.1)
    root.Anchored = false
    if hum and oldState then pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end) end
    game.StarterGui:SetCore("SendNotification", {
        Title = "🚀 Teleported!",
        Text = "Back to your saved spot ✅",
        Duration = 3
    })
end)

-- ٣. زر Remove Teleport — مسح كل شيء
makeButton("🗑️  Remove Teleport", 141, function()

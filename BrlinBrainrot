local player = game.Players.LocalPlayer

local function getRoot()
    local char = player.Character or player.CharacterAdded:Wait()
    return char:WaitForChild("HumanoidRootPart")
end

--------------------------------------------------------------------
-- نظام الحفظ الدائم
--------------------------------------------------------------------
local SAVE_FILE = "BrlinTP.txt"
local SavedCFrame = nil

if writefile and readfile and isfile and isfile(SAVE_FILE) then
    local ok, data = pcall(function()
        return game:GetService("HttpService"):JSONDecode(readfile(SAVE_FILE))
    end)
    if ok and data then
        SavedCFrame = CFrame.new(data[1], data[2], data[3])
    end
end

local function saveCFrame(cf)
    SavedCFrame = cf
    if writefile then
        pcall(function()
            local pos = cf.Position
            writefile(SAVE_FILE, game:GetService("HttpService"):JSONEncode({pos.X, pos.Y, pos.Z}))
        end)
    end
end

local function clearCFrame()
    SavedCFrame = nil
    if writefile and isfile and isfile(SAVE_FILE) then
        pcall(function() delfile(SAVE_FILE) end)
    end
end

--------------------------------------------------------------------
-- ⚡ العقل الخفي — كاشف الالتقاط!
--------------------------------------------------------------------
local autoReturn = false
local returning = false
local conn = nil

local function returnHome()
    if returning then return end
    if SavedCFrame == nil then return end
    returning = true
    pcall(function()
        local root = getRoot()
        root.Anchored = true
        task.wait()
        root.CFrame = SavedCFrame + Vector3.new(0, 3, 0)
        task.wait(0.1)
        root.Anchored = false
        local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
        if hum then hum:ChangeState(Enum.HumanoidStateType.GettingUp) end
    end)
    returning = false
end

local function watchCarry()
    if conn then conn:Disconnect(); conn = nil end
    conn = player.Character.ChildAdded:Connect(function(child)
        if not autoReturn then return end
        -- عنصر الربط (Weld/Attachment/BodyPosition...) = أمسكت حيواناً!
        if child:IsA("Weld") or child:IsA("WeldConstraint")
            or child:IsA("BodyPosition") or child:IsA("AlignPosition") then
            -- نتحقق أن العنصر يربط بـ HumanoidRootPart (جسدك)
            pcall(function()
                if child.Part0 == getRoot() or child.Part1 == getRoot() then
                    -- ⚡ سرقة موثقة! نرجع فوراً!
                    task.wait(0.05)
                    returnHome()
                    game.StarterGui:SetCore("SendNotification", {
                        Title = "⚡ Auto Return!",
                        Text = "سرقت! رجعناك لقاعدتك فوراً ✅",
                        Duration = 3
                    })
                end
            end)
        end
    end)
end

-- عند دخولك/ respawn نشاهد من جديد
if player.Character then watchCarry() end
player.CharacterAdded:Connect(function()
    task.wait(1)
    watchCarry()
end)

-- خطة احتياطية ثانية: مراقبة Backpack/Carry في العالم!
workspace.DescendantAdded:Connect(function(obj)
    if not autoReturn then return end
    pcall(function()
        -- بعض الألعاب تضع الحيوان في حوزتك مباشرة!
        if obj:IsA("Model") and obj.Name:find("Brainrot") then
            local holder = obj:FindFirstChildWhichIsA("Weld")
            if holder and (holder.Part0 == getRoot() or holder.Part1 == getRoot()) then
                task.wait(0.05)
                returnHome()
            end
        end
    end)
end)

